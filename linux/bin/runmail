#!/usr/bin/ruby
# frozen_string_literal: true

# Run & mail script

require "yaml"

require_relative "../lib/runmail"

if $0 == __FILE__
  if ARGV.empty?
    warn "Usage: #{$0} [command and argments...]"
    exit 1
  end

  opts = YAML.safe_load_file("#{__dir__}/../etc/runmail.yml", symbolize_names: true)

  runmail = Runmail.new(progname: File.basename($0, '.rb'), **opts)
  result = runmail.run_and_mail(*ARGV)

  Thread.list.select { |th| th.is_a?(Process::Waiter) }.each do |th|
    warn "waiting a running process..."
    th.join
  end

  unless result.success?
    warn result.status
    exit 2
  end
end
