#!/usr/bin/ruby
# frozen_string_literal: true

# Ansible Playbook script

require "yaml"
require "optparse"

require_relative "../lib/ansible_playbook"

if $0 == __FILE__
  config = YAML.safe_load_file("#{__dir__}/../etc/runmail.yml", symbolize_names: true)

  playbook_config = {
    check: false,
    limit: nil,
    extra_vars: [],
  }
  pre_playbooks = []
  post_playbooks = []

  opt = OptionParser.new
  opt.banner += " PYAYBOOKS..."
  opt.on("-C", "--check", "check mode") { playbook_config[:check] = true }
  opt.on("-l", "--limit=LIMIT", "limit hosts") { |v| playbook_config[:limit] = v }
  opt.on("-e", "--extra-vars=EXTRA_VARS", "extra vars") { |v| playbook_config[:extra_vars] << v }
  opt.on("-p", "--pre=PRE_PLAYBOOK", "pre playbook") { |v| pre_playbooks << v }
  opt.on("-P", "--post=POST_PLAYBOOK", "post playbook") { |v| post_playbooks << v }
  opt.on_tail("-h", "--help", "show this help message") do
    puts opt
    exit
  end
  opt.parse!(ARGV)
  playbooks = ARGV.map(&:to_s)

  pp config
  pp playbook_config
  pp playbooks
  exit

  if playbooks.empty?
    warn opt
    exit 1
  end

  config = YAML.safe_load(DATA, symbolize_names: true)

  ap = AnsiblePlaybook.new(**config)
  result = ap.playbook(playbooks, **playbook_config)

  Thread.list.select { |th| th.is_a?(Process::Waiter) }.each do |th|
    warn "waiting a running process..."
    th.join
  end

  unless result.success?
    warn result.status
    exit 2
  end
end
