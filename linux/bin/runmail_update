#!/usr/bin/ruby
# frozen_string_literal: true

# Update & Reboot script

require "yaml"
require "optparse"

require_relative "../lib/update_reboot"

if $0 == __FILE__
  if Process.euid != 0
    warn "Only root can run this program."
    exit 1
  end

  opts = YAML.safe_load_file("#{__dir__}/../etc/runmail.yml", symbolize_names: true)

  opt = OptionParser.new
  opt.on("-f", "--force", "force reboot") { opts[:force_reboot] = true }
  opt.on("-w", "--wait=SECONDS", Integer, "wait seconds before reboot") { |v| opts[:reboot_wait] = v }
  opt.parse!(ARGV)

  ur = UpdateReboot.new(progname: File.basename($0, '.rb'), **opts)
  result = ur.update_reboot

  Thread.list.select { |th| th.is_a?(Process::Waiter) }.each do |th|
    warn "waiting a running process..."
    th.join
  end

  unless result.success?
    warn result.status
    exit 2
  end
end
