#!/usr/bin/ruby
# frozen_string_literal: true
# shareable_constant_value: literal

# Run & mail script

require "optparse"
require "yaml"

require_relative "../lib/runmail"

DATA_FILE = "#{__dir__}/../etc/runmail.yml"

if $0 == __FILE__
  run_config = {}
  opt_conifg = {}

  opt = OptionParser.new
  opt.banner += " [--] command [arguments]"
  opt.on("-c", "--config=CONFIG", "config file") { |v| opt_conifg[:config] = v }
  opt.on("-n", "--dry-run", "dry run") { opt_conifg[:dry_run] = true }
  opt.on("-q", "--quiet", "quiet") { opt_conifg[:quiet] = true }
  opt.on("--no-mail", "no mail") { opt_conifg[:no_mail] = true }
  opt.on("--no-log", "no log") { opt_conifg[:no_log] = true }
  opt.on_tail("-h", "--help", "show this help message") do
    puts opt
    exit
  end
  # runmail specific options
  opt.on("-d", "--dir=DIR", "working directory") { |v| run_config[:chdir] = v }

  begin
    opt.parse!(ARGV)
  rescue OptionParser::InvalidOption => e
    warn e.message
    warn opt
    exit 8
  end

  yaml_opts = {symbolize_names: true}
  config =
    if opt_conifg[:config]
      YAML.safe_load_file(opt_conifg[:config], **yaml_opts)
    elsif File.exist?(DATA_FILE)
      YAML.safe_load_file(DATA_FILE, **yaml_opts)
    elsif defined?(DATA)
      YAML.safe_load(DATA, **yaml_opts)
    else
      {} # empty config
    end
  unless config.is_a?(Hash)
    warn "Invalid config: #{config.inspect}"
    exit 9
  end

  config[:progname] ||= opt.program_name
  config[:dry_run] = true if opt_conifg[:dry_run]
  config[:quiet] = true if opt_conifg[:quiet]
  config[:mail] = nil if opt_conifg[:no_mail]
  config[:log] = nil if opt_conifg[:no_log]

  runmail = Runmail.new(**config)

  if ARGV.empty?
    warn "Required command and arguments"
    warn opt
    exit 16
  end

  result = runmail.runmail(*ARGV)

  Thread.list.grep(Process::Waiter).each do |th|
    warn "waiting a running process..."
    th.join
  end

  exit 1 unless result.success?
end
