#!/usr/bin/ruby
# frozen_string_literal: true
# shareable_constant_value: literal

# Ansible Playbook script

require "optparse"
require "yaml"

require_relative "../lib/ansible_playbook"

DATA_FILE = "#{__dir__}/../etc/runmail.yml"

if $0 == __FILE__
  ansible_playbook_config = {}
  opt_conifg = {}

  opt = OptionParser.new
  opt.banner += " plyabooks"
  opt.on("-c", "--config=CONFIG", "config file") { |v| opt_conifg[:config] = v }
  opt.on("-n", "--dry-run", "dry run") { opt_conifg[:dry_run] = true }
  opt.on("-q", "--quiet", "quiet") { opt_conifg[:quiet] = true }
  opt.on("--no-mail", "no mail") { opt_conifg[:no_mail] = true }
  opt.on("--no-log", "no log") { opt_conifg[:no_log] = true }
  opt.on_tail("-h", "--help", "show this help message") do
    puts opt
    exit
  end
  # ansible_playbook specific options
  opt.on("-d", "--dir=DIR", "working directory") { |v| ansible_playbook_config[:chdir] = v }
  opt.on("-f", "--full", "full output") { ansible_playbook_config[:out] = :full }
  opt.on("-s", "--simple", "simple output") { ansible_playbook_config[:out] = :simple }
  opt.on("-j", "--json", "json output") { ansible_playbook_config[:out] = :json }
  opt.on("-C", "--check", "check mode") { ansible_playbook_config[:check] = true }
  opt.on("-l", "--limit=LIMIT", "limit hosts") { |v| ansible_playbook_config[:limit] = v }
  opt.on("-e", "--extra-vars=EXTRA_VARS", "extra vars") { |v| ansible_playbook_config[:extra_vars] << v }

  begin
    opt.parse!(ARGV)
  rescue OptionParser::InvalidOption => e
    warn e.message
    warn opt
    exit 8
  end

  yaml_opts = {symbolize_names: true}
  config =
    if opt_conifg[:config]
      YAML.safe_load_file(opt_conifg[:config], **yaml_opts)
    elsif File.exist?(DATA_FILE)
      YAML.safe_load_file(DATA_FILE, **yaml_opts)
    elsif defined?(DATA)
      YAML.safe_load(DATA, **yaml_opts)
    else
      {} # empty config
    end
  unless config.is_a?(Hash)
    warn "Invalid config: #{config.inspect}"
    exit 9
  end

  config[:progname] ||= opt.program_name
  config[:dry_run] = true if opt_conifg[:dry_run]
  config[:quiet] = true if opt_conifg[:quiet]
  config[:mail] = nil if opt_conifg[:no_mail]
  config[:log] = nil if opt_conifg[:no_log]

  ansible_playbook = AnsiblePlaybook.new(**config)

  if ARGV.empty?
    warn "Required playbooks"
    warn opt
    exit 16
  end

  result = ansible_playbook.runmail_ansible_playbook(*ARGV, **ansible_playbook_config)

  Thread.list.grep(Process::Waiter).each do |th|
    warn "waiting a running process..."
    th.join
  end

  exit 1 unless result.success?
end
